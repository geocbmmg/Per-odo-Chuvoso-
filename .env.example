# ─────────────────────────────────────────────────────────────────────────────
# Sala de Situação — Período Chuvoso (CBMMG) · variáveis de ambiente
#
# Desenvolvimento: copie para .env.local (nunca versionado) e preencha.
# Vercel: Project → Settings → Environment Variables, marcando as credenciais
# como "Sensitive". Mesmo padrão do GeoRescue.
#
# Regra: NENHUM segredo com prefixo NEXT_PUBLIC_. Todas as variáveis abaixo
# são lidas só no servidor (lib/env.ts importa "server-only").
# ─────────────────────────────────────────────────────────────────────────────

# ── ArcGIS Enterprise do CBMMG (fonte de verdade) ────────────────────────────
# Base dos feature services hospedados. Os serviços da Sala de Situação são
# públicos e, nesta fase, o acesso é SOMENTE LEITURA (apenas /query).
ARCGIS_SERVICES_URL=https://geoprocessamento.bombeiros.mg.gov.br/server/rest/services/Hosted

# Portal e credenciais de serviço — reservados para LEITURA de camadas restritas
# (token gerado no servidor) em fases futuras. NÃO são usados na Fase 0, que é
# somente leitura de serviços públicos. Qualquer escrita no ArcGIS (applyEdits)
# está fora do escopo e exigirá decisão e revisão específicas.
ARCGIS_PORTAL=https://geoprocessamento.bombeiros.mg.gov.br/portal
ARCGIS_USER=
ARCGIS_PASS=

# ── Banco de dados (Neon / Vercel Postgres) ──────────────────────────────────
# Opcional na Fase 0 (nada é migrado). Formato:
# postgresql://usuario:senha@host/banco?sslmode=require
DATABASE_URL=

# ── ANA HidroWebService (telemetria de rios) — stub na Fase 0 ────────────────
# Cadastro gratuito na ANA: identificador (CPF/CNPJ cadastrado) e senha/token.
ANA_IDENTIFICADOR=
ANA_TOKEN=

# ── Cron jobs (/api/ingest/*) ────────────────────────────────────────────────
# A Vercel envia "Authorization: Bearer <CRON_SECRET>" nas chamadas agendadas.
# Use um valor aleatório com 16+ caracteres (ex.: openssl rand -hex 32).
# Sem ele, os jobs só rodam em desenvolvimento.
CRON_SECRET=

# ── Última leitura válida (fallback quando a fonte cai) ─────────────────────
# memoria (padrão): por instância serverless — perde-se em cold start.
# postgres: também grava na tabela leituras_fontes (exige DATABASE_URL e um
# `npm run db:push` antes); sobrevive a cold starts e vale para todas as instâncias.
ARMAZEM_LEITURAS=memoria

# ── Comportamento ────────────────────────────────────────────────────────────
# 1 = modo demonstração: as fontes devolvem dados de EXEMPLO (fictícios), sem
# acessar a internet. A interface mostra uma faixa "MODO DE DEMONSTRAÇÃO".
# Em produção deixe 0.
DADOS_EXEMPLO=0

# Tempo máximo (ms) de cada chamada às fontes externas.
FONTES_TIMEOUT_MS=15000

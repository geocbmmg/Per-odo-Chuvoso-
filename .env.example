# ─────────────────────────────────────────────────────────────────────────────
# Sala de Situação — Período Chuvoso (CBMMG) · variáveis de ambiente
#
# Desenvolvimento: copie para .env.local (nunca versionado) e preencha.
# Vercel: Project → Settings → Environment Variables, marcando as credenciais
# como "Sensitive". Mesmo padrão do GeoRescue.
#
# Regra: NENHUM segredo com prefixo NEXT_PUBLIC_. Todas as variáveis abaixo
# são lidas só no servidor (lib/env.ts importa "server-only").
# ─────────────────────────────────────────────────────────────────────────────

# ── ArcGIS Enterprise do CBMMG (fonte de verdade) ────────────────────────────
# Base dos feature services hospedados. Os serviços da Sala de Situação são
# públicos e, nesta fase, o acesso é SOMENTE LEITURA (apenas /query).
ARCGIS_SERVICES_URL=https://geoprocessamento.bombeiros.mg.gov.br/server/rest/services/Hosted

# Portal e credenciais de serviço — reservados para LEITURA de camadas restritas
# (token gerado no servidor) quando as camadas da Sala forem criadas. Ainda não
# são usados: a leitura é de serviços públicos. Qualquer escrita no ArcGIS
# (applyEdits) está fora do escopo e exigirá decisão e revisão específicas.
ARCGIS_PORTAL=https://geoprocessamento.bombeiros.mg.gov.br/portal
ARCGIS_USER=
ARCGIS_PASS=

# ── Banco de dados (Neon / Vercel Postgres) ──────────────────────────────────
# OBRIGATÓRIO em produção: a fila de alertas grava nele (ALERTAS_ARMAZEM=postgres)
# e, recomendado, a última leitura válida das fontes (ARMAZEM_LEITURAS=postgres).
# Rode `npm run db:push` uma vez para criar as tabelas. As páginas só de leitura
# funcionam sem ele. Formato:
# postgresql://usuario:senha@host/banco?sslmode=require
DATABASE_URL=

# ── ANA HidroWebService (telemetria de rios) — stub na Fase 0 ────────────────
# Cadastro gratuito na ANA: identificador (CPF/CNPJ cadastrado) e senha/token.
ANA_IDENTIFICADOR=
ANA_TOKEN=

# ── Cron jobs (/api/ingest/*) ────────────────────────────────────────────────
# A Vercel envia "Authorization: Bearer <CRON_SECRET>" nas chamadas agendadas.
# Use um valor aleatório com 16+ caracteres (ex.: openssl rand -hex 32).
# Sem ele, os jobs só rodam em desenvolvimento.
CRON_SECRET=

# ── Última leitura válida (fallback quando a fonte cai) ─────────────────────
# memoria (padrão): por instância serverless — perde-se em cold start.
# postgres: também grava na tabela leituras_fontes (exige DATABASE_URL e um
# `npm run db:push` antes); sobrevive a cold starts e vale para todas as instâncias.
ARMAZEM_LEITURAS=memoria

# ── Fila de alertas da Sala (docs/fase-1.md §4) ──────────────────────────────
# Onde a fila grava os alertas, a ciência das unidades, as ações RRD e o histórico:
#   memoria  (padrão): só desenvolvimento e testes. Em produção é RECUSADO
#            (a memória da instância perde os alertas num cold start).
#   postgres: tabelas sala_alertas, sala_acoes_rrd, sala_alertas_destinatarios e
#            sala_alertas_historico (exige DATABASE_URL e `npm run db:push`).
#   arcgis:  lê as camadas SalaSituacao_AlertasRRD. A ESCRITA no ArcGIS está
#            DESLIGADA nesta fase (toda gravação responde 503) até as camadas
#            serem criadas (scripts/arcgis/criar_camadas_sala.py) e autorizadas.
# Com DADOS_EXEMPLO=1 a fila usa sempre a memória, com alertas de exemplo.
ALERTAS_ARMAZEM=memoria

# Segredo do pseudônimo de autoria (LGPD): quem emitiu, alterou, deu ciência ou
# registrou ação é gravado como HMAC-SHA256 do identificador do usuário com
# este segredo — nunca CPF, nome ou nº BM. 32+ caracteres aleatórios
# (ex.: openssl rand -hex 32). NÃO troque depois de em uso: os pseudônimos
# antigos deixariam de casar com os novos. Sem ele, a fila não grava (503);
# no modo demonstração vale uma chave fixa de exemplo.
SALA_PSEUDO_SEGREDO=

# ── Login federado pelo GeoRescue (docs/fase-1.md §3) ────────────────────────
# A tela /entrar repassa CPF e senha, DE SERVIDOR PARA SERVIDOR, ao
# POST <GEORESCUE_BASE_URL>/api/login. A Sala não guarda senha nem lê a tabela
# de usuários; o token do GeoRescue é descartado e a Sala emite sessão própria
# (cookie HttpOnly __Host-sala_sessao, no máximo 8 h).
#
# URL de produção do GeoRescue, sem barra no fim (não é segredo). Use https;
# http só para um GeoRescue local em desenvolvimento.
GEORESCUE_BASE_URL=

# Cifra e autentica o cookie de sessão da Sala (AES-256-GCM, chave derivada
# deste valor). 32+ caracteres aleatórios (ex.: openssl rand -hex 32),
# DIFERENTE do GEORESCUE_SECRET — a Sala não precisa do segredo do GeoRescue.
# Trocar este valor encerra todas as sessões abertas (é o jeito de revogar em
# massa). Sem ele, ou com menos de 32 caracteres, o login real fica DESLIGADO
# (503, falha fechada).
# O pseudônimo do usuário na sessão usa SALA_PSEUDO_SEGREDO (acima); sem ele,
# é derivado deste segredo — e muda quando este segredo mudar.
SALA_SESSION_SECRET=

# Nome do domínio de GRUPO do GeoRescue que dá o papel "Operador da Sala"
# (com papel gerenciador, Gestor ou Operador). Padrão: SALA. Ao marcar o grupo
# numa conta, marque também o COB da pessoa (ex.: 1COB + SALA): no GeoRescue
# o domínio explícito vence o derivado da unidade.
SALA_GRUPO_OPERADOR=SALA

# ── Comportamento ────────────────────────────────────────────────────────────
# 1 = modo demonstração: as fontes devolvem dados de EXEMPLO (fictícios), sem
# acessar a internet. A interface mostra uma faixa "MODO DE DEMONSTRAÇÃO".
# O login também não chama o GeoRescue: /entrar oferece três perfis fictícios
# (sessão cifrada com SALA_SESSION_SECRET ou, sem ele, com uma chave fixa de
# demonstração) e, sem cookie, vale o "Operador de demonstração".
# Em produção deixe 0.
DADOS_EXEMPLO=0

# Tempo máximo (ms) de cada chamada às fontes externas.
FONTES_TIMEOUT_MS=15000
